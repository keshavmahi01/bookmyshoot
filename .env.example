# Point this at your MongoDB. Leave it empty and the site runs on a local
# JSON file instead, which is handy before MongoDB is set up.
#
# Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017
#
# MongoDB Atlas
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=bookmyshoot

# Signs the login cookie. Put a long random value here before going live.
SESSION_SECRET=change-this-to-a-long-random-string
